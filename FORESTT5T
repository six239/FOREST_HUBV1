-- =============================================================================
-- RULE 1 IMPLEMENTED: FULLY FUNCTIONAL TAB SYSTEM
-- =============================================================================

local function switchTab(targetTabName)
    CurrentActiveTab = targetTabName

    for tabName, frame in pairs(TabFrames) do
        frame.Visible = (tabName == targetTabName)
    end

    for tabName, button in pairs(TabButtons) do
        if tabName == targetTabName then
            button.BackgroundColor3 = Color3.fromRGB(32, 24, 46)
            button.BackgroundTransparency = 0
            button.TextColor3 = Color3.fromRGB(255, 255, 255)
            button:FindFirstChild("Indicator").Visible = true
        else
            button.BackgroundTransparency = 1
            button.TextColor3 = Color3.fromRGB(145, 135, 160)
            button:FindFirstChild("Indicator").Visible = false
        end
    end
end

local function createTabButton(name, order)
    local button = Instance.new("TextButton")
    button.Parent = LeftSideBar
    button.Text = "   " .. name
    button.Size = UDim2.new(1, 0, 0, 34)
    button.BackgroundTransparency = 1
    button.TextColor3 = Color3.fromRGB(145, 135, 160)
    button.Font = Enum.Font.SourceSansBold
    button.TextXAlignment = Enum.TextXAlignment.Left
    button.TextSize = 13
    button.LayoutOrder = order

    local Indicator = Instance.new("Frame")
    Indicator.Name = "Indicator"
    Indicator.Size = UDim2.new(0, 3, 1, 0)
    Indicator.Position = UDim2.new(0, 0, 0, 0)
    Indicator.BackgroundColor3 = Color3.fromRGB(150, 75, 245)
    Indicator.Visible = false
    Indicator.Parent = button

    TabButtons[name] = button

    button.MouseButton1Click:Connect(function()
        switchTab(name)
    end)
end

-- =============================================================================
-- RULE 3 IMPLEMENTED: AUTO-SIZING SCROLLING FRAME CANVAS ENGINE
-- =============================================================================

local function createTabContentFrame(name)
    local ScrollingFrame = Instance.new("ScrollingFrame")
    ScrollingFrame.Name = name .. "ContentPanel"
    ScrollingFrame.Parent = MainPanel
    ScrollingFrame.Position = UDim2.new(0, 148, 0, 46)
    ScrollingFrame.Size = UDim2.new(1, -156, 1, -54)
    ScrollingFrame.BackgroundColor3 = Color3.fromRGB(16, 12, 24)
    ScrollingFrame.BorderSizePixel = 0
    ScrollingFrame.ScrollBarThickness = 3
    ScrollingFrame.ScrollBarImageColor3 = Color3.fromRGB(60, 45, 90)
    ScrollingFrame.Visible = false

    local ListLayout = Instance.new("UIListLayout")
    ListLayout.SortOrder = Enum.SortOrder.LayoutOrder
    ListLayout.Padding = UDim.new(0, 5)
    ListLayout.Parent = ScrollingFrame

    -- Automated Canvas Vector Expansion Logic
    ListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        ScrollingFrame.CanvasSize = UDim2.new(0, 0, 0, ListLayout.AbsoluteContentSize.Y + 15)
    end)

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 6)
    Corner.Parent = ScrollingFrame

    TabFrames[name] = ScrollingFrame
    return ScrollingFrame
end

